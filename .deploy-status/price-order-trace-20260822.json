    "sql": "SELECT SQL_CALC_FOUND_ROWS  wp_posts.*\n\t\t\t\t\t FROM wp_posts  LEFT JOIN wp_wc_product_meta_lookup wc_product_meta_lookup ON wp_posts.ID = wc_product_meta_lookup.product_id \n\t\t\t\t\t WHERE 1=1  AND ( \n  wp_posts.ID NOT IN (\n\t\t\t\tSELECT object_id\n\t\t\t\tFROM wp_term_relationships\n\t\t\t\tWHERE term_taxonomy_id IN (7,9)\n\t\t\t)\n) AND wp_posts.post_author NOT IN (4508,4509)  AND wp_posts.post_type = 'product' AND ((wp_posts.post_status = 'publish')) AND wp_posts.post_status = 'publish' AND NOT EXISTS (SELECT 1 FROM wp_term_relationships emo_vis_tr INNER JOIN wp_term_taxonomy emo_vis_tt ON emo_vis_tt.term_taxonomy_id = emo_vis_tr.term_taxonomy_id WHERE emo_vis_tr.object_id = wp_posts.ID AND emo_vis_tt.taxonomy = 'product_visibility' AND emo_vis_tt.term_id IN (7,9)) AND wp_posts.post_author NOT IN (4508,4509)\n\t\t\t\t\t GROUP BY wp_posts.ID\n\t\t\t\t\t ORDER BY  wc_product_meta_lookup.min_price ASC, wc_product_meta_lookup.product_id ASC \n\t\t\t\t\t LIMIT 0, 15",
