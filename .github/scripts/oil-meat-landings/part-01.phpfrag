    update_post_meta($id, '_en_US_post_excerpt', $cfg['en_meta']);
    update_post_meta($id, '_en_US_post_content', '<span data-no-translation>'.$en.'</span>');
    update_post_meta($id, '_en_US_published', '1');
    emdo_oc_aioseo($id, $cfg['seo_title'], $cfg['es_meta']);
    return array('key'=>$cfg['key'],'group'=>$cfg['group'],'id'=>$id,'es_url'=>home_url('/'.$cfg['es_slug'].'/'),'en_url'=>home_url('/en/'.$cfg['en_slug'].'/'),'products'=>emdo_oc_resolve_product_ids($cfg['products']));
}

function emdo_oc_append_category_links(string $term_slug, array $rows): bool {
    $term = get_term_by('slug', $term_slug, 'product_cat');
    if (!$term || is_wp_error($term)) return false;
    $start='<!-- emdo-commercial-landings-'.$term_slug.'-start -->';
    $end='<!-- emdo-commercial-landings-'.$term_slug.'-end -->';
    $pattern='/\s*'.preg_quote($start,'/').'.*?'.preg_quote($end,'/').'\s*/s';
    $es=(string)$term->description;
    $es=preg_replace($pattern,"\n",$es);
    $links=array(); foreach($rows as $r){$links[]='<a href="'.esc_url($r['es_url']).'">'.esc_html($r['es_label']).'</a>';}
    $es_block=$start.'<p><strong>Explora también:</strong> '.implode(' · ',$links).'.</p>'.$end;
    $res=wp_update_term((int)$term->term_id,'product_cat',array('description'=>trim($es)."\n\n".$es_block));

    $en=(string)get_term_meta((int)$term->term_id,'_en_US_description',true);
    if($en!==''){
        $en=preg_replace($pattern,"\n",$en);
        $links=array(); foreach($rows as $r){$links[]='<a href="'.esc_url($r['en_url']).'">'.esc_html($r['en_label']).'</a>';}
        $en_block=$start.'<p><strong>Explore also:</strong> '.implode(' · ',$links).'.</p>'.$end;
        update_term_meta((int)$term->term_id,'_en_US_description',trim($en)."\n\n".$en_block);
    }
    return !is_wp_error($res);
}

