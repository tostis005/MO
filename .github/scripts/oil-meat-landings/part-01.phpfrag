$pages[] = array(
'key'=>'aove-almazara','group'=>'aceites','es_slug'=>'aceite-oliva-virgen-extra-directo-almazara','en_slug'=>'extra-virgin-olive-oil-direct-from-spanish-mill',
'es_title'=>'Aceite de Oliva Virgen Extra Directo de Almazara','en_title'=>'Extra Virgin Olive Oil Direct from a Spanish Mill',
'seo_title'=>'Comprar AOVE Directo de Almazara | El Mercado de Origen',
'es_meta'=>'Compra aceite de oliva virgen extra elaborado por una almazara familiar. Compara formatos de 5 L, 1 L y 500 ml de 1957 en El Mercado de Origen.',
